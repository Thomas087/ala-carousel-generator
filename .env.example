# Copy this file to `.env` at the project root and fill in your key.
#
# OPENAI_API_KEY is used by the carousel-image pipeline
# (.claude/skills/generating-carousel-images/generate_image.sh) to call the
# OpenAI Images API (gpt-image-2). The script walks up from the current
# directory to find the nearest .env, so this file at the repo root is enough.
#
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
